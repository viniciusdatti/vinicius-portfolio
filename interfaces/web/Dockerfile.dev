# Development image — CRA dev server + Fast Refresh (volume-mounted source)
# Stack note: project uses react-scripts (port 3000), not Vite — see docs/DOCKER.md
FROM node:20-alpine

WORKDIR /app

RUN apk add --no-cache libc6-compat curl

# Dependency layer cache (invalidates only when lockfile changes)
COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile

# Bootstrap source (overridden by bind mount in compose; needed for first boot)
COPY tsconfig.json ./
COPY public ./public
COPY src ./src
COPY scripts ./scripts

EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=5s --start-period=180s --retries=10 \
    CMD curl -f http://127.0.0.1:3000/ || exit 1

CMD ["yarn", "start"]
