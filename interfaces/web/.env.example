# ===========================================
# Portfolio Frontend (Vite) — copy to .env
# ===========================================

# API URL (REST base; must include /api/v1)
# Dev (recommended): same-origin via Vite proxy — no CORS issues
VITE_API_URL=/api/v1
# Production / direct API:
# VITE_API_URL=http://localhost:8000/api/v1

# Optional: dev server port (default 5173)
# VITE_DEV_PORT=5173

# Optional: Vite proxy target when using /api proxy in vite.config.ts
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000

VITE_APP_ENV=development
