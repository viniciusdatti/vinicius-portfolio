# ===========================================
# Portfolio Frontend (Vite) — copy to .env
# ===========================================

# API URL (REST base; must include /api/v1)
#
# --- Local dev (recommended) ---
# Same-origin via Vite proxy (vite.config.ts → backend :8000)
VITE_API_URL=/api/v1
#
# --- Production: Docker / nginx (docker-compose.prod.yml) ---
# VITE_API_URL=/api/v1
#
# --- Production: Vercel + Render (split hosts) ---
# VITE_API_URL=https://vinicius-portfolio.onrender.com/api/v1
# VITE_APP_ENV=production
# On Render set CORS_ORIGINS=https://YOUR-APP.vercel.app (exact origin, no trailing slash)
# Vercel reads interfaces/web/vercel.json (output dist, Node 22, SPA rewrites).

# Optional: dev server port (default 5173)
# VITE_DEV_PORT=5173

# Optional: Vite proxy target when using /api proxy in vite.config.ts
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000

VITE_APP_ENV=development
