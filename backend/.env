# ===========================================
# Portfolio Backend Environment Variables
# ===========================================

# Environment
ENVIRONMENT=development

# Database (SQLite for development)
DATABASE_URL=sqlite:///./portfolio.db

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT Authentication
JWT_SECRET_KEY=dev-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Email (Resend)
RESEND_API_KEY=re_MwySe18d_2CmaCE7bVGfHibMnDEainBKX
EMAIL_FROM=onboarding@resend.dev
EMAIL_TO_ADMIN=viniciusdatti@gmail.com

# Telegram Notifications - Optional for development
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# TELEGRAM_CHAT_ID=123456789

# Cloudinary (Image Upload) - Optional for development
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=123456789012345
# CLOUDINARY_API_SECRET=your-api-secret

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_CONTACT_PER_HOUR=200

# Logging
LOG_LEVEL=DEBUG
