{
  "mcpServers": {
    "filesystem": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/path/to/vinicius-portfolio",
        "/path/to/vinicius-portfolio/interfaces/web",
        "/path/to/vinicius-portfolio/backend",
        "/path/to/vinicius-portfolio/docs"
      ]
    },
    "shell": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@mako10k/mcp-shell-server"],
      "cwd": "/path/to/vinicius-portfolio",
      "env": {
        "MCP_SHELL_DEFAULT_WORKDIR": "/path/to/vinicius-portfolio",
        "MCP_SHELL_SECURITY_MODE": "strict"
      }
    },
    "playwright": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@playwright/mcp@0.0.75",
        "--config",
        "/path/to/vinicius-portfolio/.cursor/playwright-mcp.config.json"
      ],
      "cwd": "/path/to/vinicius-portfolio/interfaces/web",
      "env": {
        "PLAYWRIGHT_MCP_ALLOWED_ORIGINS": "http://localhost:5173;http://127.0.0.1:5173;http://localhost:3000;http://127.0.0.1:3000;http://localhost:8000;http://127.0.0.1:8000;https://fonts.googleapis.com;https://fonts.gstatic.com"
      }
    }
  }
}
