# ===========================================
# Docker Compose — copy to .env.docker
# cp .env.docker.example .env.docker
# ===========================================

# PostgreSQL
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio
POSTGRES_DB=portfolio
POSTGRES_PORT=5432

# Backend (published to host for Vite on host)
BACKEND_PORT=8000

# CORS — Vite dev server (5173) + legacy CRA port if needed
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
RUN_SEED=true

# Frontend (interfaces/web/.env) — not used by compose; Vite runs on host
# VITE_API_URL=http://localhost:8000/api/v1
# VITE_DEV_PORT=5173
